# Copy this file to .env and replace placeholder values.
# .env is ignored by git; do not commit real API keys.

# Required outside fixture mode. Generate a long random value and keep it private.
SESSION_SECRET=replace-with-a-long-random-session-secret
TRINETRA_SESSION_COOKIE_SECURE=false
TRINETRA_SESSION_IDLE_OBSCURE_SECONDS=120
TRINETRA_SESSION_IDLE_WARNING_SECONDS=780
TRINETRA_SESSION_IDLE_TIMEOUT_SECONDS=900

TRINETRA_MODE=live
TRINETRA_ENABLE_LIVE_TRON=true
TRONGRID_API_KEY=replace-with-your-trongrid-key
TRONSCAN_API_KEY=replace-with-your-tronscan-key

# These gates mean you have verified current provider response shapes and smoke-tested live access.
TRINETRA_LIVE_TRON_SCHEMA_VERIFIED=true
TRINETRA_LIVE_TRON_SMOKE_VERIFIED=true
TRINETRA_LIVE_TRON_TRACE_VERIFIED=true
TRINETRA_ENABLE_FRONTIER_WORKER=true
TRINETRA_ENABLE_WALLET_WATCH=false

# Optional provider tuning.
TRONGRID_BASE_URL=https://api.trongrid.io
TRINETRA_PROVIDER_TIMEOUT_S=10
TRINETRA_PROVIDER_PAGE_LIMIT=200
TRINETRA_PROVIDER_MAX_PAGES=20
TRINETRA_WORKER_POLL_INTERVAL_S=3
TRINETRA_WORKER_BATCH_SIZE=3
TRINETRA_WORKER_LEASE_TIMEOUT_MS=120000
TRINETRA_WORKER_MAX_CASES_PER_CYCLE=20
TRINETRA_DATA_STALE_AFTER_SECONDS=900
TRINETRA_RISK_LOOKBACK_DAYS=30
TRINETRA_PROVIDER_REQUEST_BUDGET_PER_MINUTE=120
TRINETRA_PROVIDER_INTERACTIVE_RESERVE_PER_MINUTE=40
TRINETRA_WATCHLIST_CAP=100
TRINETRA_WATCH_AUTO_MIN_BASE=1000000000
TRINETRA_WATCH_HOT_VALUE_BASE=10000000000
TRINETRA_WATCH_MATERIAL_TRANSFER_BASE=1000000000
TRINETRA_WATCH_HOT_INTERVAL_SECONDS=60
TRINETRA_WATCH_STANDARD_INTERVAL_SECONDS=300
TRINETRA_WATCH_COLD_INTERVAL_SECONDS=1800
TRINETRA_WATCH_DORMANT_AFTER_SECONDS=86400
TRINETRA_WATCH_POLL_BATCH_SIZE=5
